{
  "name": "daily-news",
  "version": "0.1.0",
  "description": "AI 驱动的每日资讯日刊：采集 Twitter → AI 筛选 → 人工复选 → Obsidian + Substack",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --import tsx src/generate.ts",
    "generate:review": "node --import tsx src/generate.ts --mode=review",
    "generate:review:diagnose": "DAILY_NEWS_ENV_DIAGNOSTICS=1 node --import tsx src/generate.ts --mode=review --diagnose-collect-env",
    "preferences:update": "node --import tsx src/preferenceCli.ts update",
    "preferences:review": "node --import tsx src/preferenceCli.ts review",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@inquirer/prompts": "^7.10.1",
    "ai": "^4.3.19",
    "dotenv": "^16.6.1",
    "openai": "^4.104.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2"
  }
}
